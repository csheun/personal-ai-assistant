# Copy to backend/.env. Never commit .env.
# Milestone 3 needs nothing here: every tool and the planner are mocked, so the defaults work.

# --- Workflows ---
# Multiplier for mocked tools' simulated latency (0 = instant, 1 = realistic demo pacing).
MOCK_LATENCY_SCALE=1
# Browser origins allowed to call the API (JSON list). Add yours if the frontend runs elsewhere.
CORS_ORIGINS=["http://localhost:3000"]
# Seconds of silence before an SSE keep-alive comment is sent.
SSE_HEARTBEAT_SECONDS=15
TOOL_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO

# --- LLM (not used until Milestone 4) ---
# The Milestone 1 LangGraph agent in app/agent/ reads these; no route uses it right now.
# One of: groq | openai | anthropic
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional, openai provider only: any OpenAI-compatible server, e.g. Ollama at http://localhost:11434/v1
# LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_ITERATIONS=5
