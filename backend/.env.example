# Copy to backend/.env and fill in what you use. Never commit backend/.env.
# Only the variables for the providers you actually use are needed.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# true  = demo: keyword planner + simulated tools. Needs no keys at all.
# false = live: LLM planner + real Weather / Web Search (+ Telegram if configured).
MOCK_MODE=true

# ---------------------------------------------------------------------------
# LLM (required when MOCK_MODE=false)
# ---------------------------------------------------------------------------
# groq | openai | anthropic. Set the matching *_API_KEY; the others are ignored.
LLM_PROVIDER=groq
#   groq:      openai/gpt-oss-120b
#   openai:    any chat model with structured output      (pip install -e ".[openai]")
#   anthropic: e.g. claude-sonnet-5-5                       (pip install -e ".[anthropic]")
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional, openai provider only: any OpenAI-compatible server, e.g. Ollama at http://localhost:11434/v1
# LLM_BASE_URL=

# Limits (defaults shown)
# LLM_TIMEOUT_SECONDS=45        hard limit per LLM call
# LLM_MAX_TOKENS=2048           output cap per call
# LLM_MAX_RETRIES=1             provider retries on transient errors
# PLANNER_MAX_ATTEMPTS=2        1 draft + 1 repair after validation errors
# PLANNER_MAX_TASKS=8
# PLANNER_MAX_DEPTH=4
# LLM_STRUCTURED_OUTPUT=        json_schema | function_calling | json_mode (default depends on provider)

# ---------------------------------------------------------------------------
# Tools (MOCK_MODE=false)
# ---------------------------------------------------------------------------
# Weather: Open-Meteo (https://open-meteo.com). No key needed.
# WEATHER_TIMEOUT_SECONDS=8

# Web search: Tavily (https://tavily.com, free tier). Without a key, web search is disabled.
WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_SECONDS=10

# Telegram (https://core.telegram.org/bots). Without BOTH values, sending is simulated.
# 1. Message @BotFather, send /newbot, copy the token.
# 2. Open a chat with your new bot and send it any message.
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
# The ONLY chat the assistant can ever message. Never chosen by the LLM.
TELEGRAM_CHAT_ID=
# How the destination appears on the approval card.
TELEGRAM_CHAT_LABEL=your Telegram chat
# TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Simulated latency for mocked tools (0 = instant, 1 = realistic demo pacing).
MOCK_LATENCY_SCALE=1
CORS_ORIGINS=["http://localhost:3000"]
SSE_HEARTBEAT_SECONDS=15
TOOL_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
