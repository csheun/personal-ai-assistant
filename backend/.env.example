# Copy to backend/.env and fill in. Never commit .env.

# --- LLM provider ---
# One of: groq | openai | anthropic
LLM_PROVIDER=groq
# Must be a model that supports tool calling on that provider.
#   groq:      openai/gpt-oss-120b, llama-3.3-70b-versatile
#   openai:    gpt-5-mini        (pip install -e ".[openai]")
#   anthropic: claude-sonnet-5-5 (pip install -e ".[anthropic]")
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional, openai provider only: any OpenAI-compatible server, e.g. Ollama at http://localhost:11434/v1
# LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60

# --- Agent ---
AGENT_MAX_ITERATIONS=5
TOOL_TIMEOUT_SECONDS=10

LOG_LEVEL=INFO
