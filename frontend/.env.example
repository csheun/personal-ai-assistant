# Copy to .env.local. Restart `npm run dev` after changing (NEXT_PUBLIC_* values are build-time).

# http = talk to the FastAPI backend; mock = simulate everything in the browser (demo mode).
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock mode only: multiplier for simulated task durations (or add ?mock_speed=3 to the URL).
# NEXT_PUBLIC_MOCK_SPEED=1
